# SmartHome AI — Environment Configuration Template
# Copy this file to .env and replace with your local credentials

# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=smarthome

# IoT Physical Device Security (Optional)
DEVICE_API_KEY=your_optional_device_token_here
